  m_Script: {fileID: 11500000, guid: 5b3260d2a0ec5444488c0e286149a1ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  sceneLoader: {fileID: 1726617833}
  nextSceneName: Match Scene
  npcBubble: {fileID: 692976944}
  playerBubble: {fileID: 481272447}
  npcPortraitImage: {fileID: 1700438357}
  playerPortraitImage: {fileID: 197898001}
  cameraManager: {fileID: 997473142}
  npcTextBox: {fileID: 487838479}
  playerTextBox: {fileID: 133538803}
  option1Button: {fileID: 59594418}
  option2Button: {fileID: 1997261701}
  option1Text: {fileID: 1146417313}
  option2Text: {fileID: 2003834853}
  dialogueNodes:
  - npcText: 
    playerText: '*Inner thought* This wasn''t in the Chief''s debriefing.  '
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 1
  - npcText: Hey, hey you. Do I know you?
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 1
    option1Text: Play it cool
    option2Text: Be rude
    nextNodeForOption1: 2
    nextNodeForOption2: 3
    nextNode: 0
  - npcText: 
    playerText: 'Yeah, I play here like every other night. '
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 4
  - npcText: 
    playerText: Why do you want to know?
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 5
  - npcText: With that racket you'd be hard to miss.
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 6
  - npcText: 'The boss is curious. '
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 7
  - npcText: 
    playerText: OMG, what type of mascara are you wearing? I love mascara.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 8
  - npcText: 
    playerText: The boss is curious in me? How would I go about talking to him.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 9
  - npcText: You mean my eyeliner.
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 9
  - npcText: Nice try. Enough playing around who are you.
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 10
  - npcText: 
    playerText: I'm not telling some wannabe punk my name, you first.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 11
  - npcText: 'If you insist. This wannabe punks name is Persephone. '
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 12
  - npcText: 
    playerText: 'Yawn, so your nobody important '
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 13
  - npcText: I don't know if i would count a floor boss unimportant.
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 1
    option1Text: Apologize
    option2Text: Act like a know-it-all
    nextNodeForOption1: 14
    nextNodeForOption2: 15
    nextNode: 0
  - npcText: 
    playerText: 'Sorry, this really is my first time here. '
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 16
  - npcText: 
    playerText: I knew who you were all along.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 16
  - npcText: 
    playerText: My name is uhh Lilith.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 17
  - npcText: Your not a cop uhh Lilith.
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 18
  - npcText: 
    playerText: Would I make it so obvious?
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 19
  - npcText: 'Or are you trying to throw me off. '
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 20
  - npcText: 
    playerText: I'm just here to play tennis. Cops despise tennis.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 21
  - npcText: 'That is true. Mmmm, you won''t make it far with that racket. '
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 22
  - npcText: 
    playerText: It was good enough for my mom.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 23
  - npcText: And who is your mom?
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 1
    option1Text: Be vulnerable
    option2Text: Lie
    nextNodeForOption1: 24
    nextNodeForOption2: 25
    nextNode: 0
  - npcText: 
    playerText: She was one of the tennis players apart of the HCC match.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 26
  - npcText: 
    playerText: She liked collecting rackets from before tennis was banned.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 27
  - npcText: I see, well us kids of tennis players must stick together.
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 28
  - npcText: How weird of her....
    playerText: 
    npcPortrait: {fileID: 0}
    playerPortrait: {fileID: 0}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 30
  - npcText: 
    playerText: Wait, your parents were tennis players?
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 29
  - npcText: 'My dad just played a country clubs about business deals. Now he is
      a deadbeat drunk. '
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 30
  - npcText: 
    playerText: Can I ask you something?
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 31
  - npcText: Go for it.
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 32
  - npcText: 
    playerText: Does every floor here have floor bosses like yourself.
    npcPortrait: {fileID: 0}
    playerPortrait: {fileID: 0}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 33
  - npcText: 'Wow you really are a newbie, but yes there are. '
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 34
  - npcText: 
    playerText: How do I make it to the big boss.
    npcPortrait: {fileID: 0}
    playerPortrait: {fileID: 0}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 35
  - npcText: Slow your roll, you must beat me first then then the other bosses before
      you think about him.
    playerText: 
    npcPortrait: {fileID: 0}
    playerPortrait: {fileID: 0}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 36
  - npcText: 
    playerText: Let's go right now then.
    npcPortrait: {fileID: 0}
    playerPortrait: {fileID: 0}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 37
  - npcText: I like your fire so I'm gonna make you an offer. If you beat me I'll
      help you find the big boss and if I beat you I get a new lackey. Deal?
    playerText: 
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2125523727, guid: 233f62864b22e4916b85f92b1e1590a1, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 38
  - npcText: 
    playerText: Bring it.
    npcPortrait: {fileID: 2135706243, guid: f34b813c676404df6bf0beb96fa29f6e, type: 3}
    playerPortrait: {fileID: 2135055865, guid: b2e8d5cf01a9a45a9a47b5aff3b26775, type: 3}
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 39
  typingSpeed: 0.07
