  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b3260d2a0ec5444488c0e286149a1ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  sceneLoader: {fileID: 312465825}
  nextSceneName: Scene 1
  npcBubble: {fileID: 692976944}
  playerBubble: {fileID: 481272447}
  cameraManager: {fileID: 347222414}
  npcTextBox: {fileID: 487838479}
  playerTextBox: {fileID: 133538803}
  option1Button: {fileID: 59594418}
  option2Button: {fileID: 1997261701}
  option1Text: {fileID: 1146417313}
  option2Text: {fileID: 2003834853}
  dialogueNodes:
  - npcText: Lilith are you listening?
    playerText: Yes, sir.
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 1
  - npcText: We are putting you undercover?
    playerText: Really undercover?
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 2
  - npcText: Is that sass? Aren't you the one always asking for assignments to take
      down those no good tennis players?
    playerText: Yeah but I have to pretend to be like them.
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 3
  - npcText: You know your the best person for the case.I need someone who is emotionally
      driven for this.
    playerText: Why now, we have been busting courts for two years now.
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 4
  - npcText: We got intel about the biggest underground tennis circuit out there.
    playerText: Are you talking about Inferno? I thought it was just a rumor.
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 5
  - npcText: Not at all we have a location but this place is huge so we need you
      to go in and uncover the Boss identity.
    playerText: Then what?
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 6
  - npcText: We can finally put in end to tennis at it's last root.
    playerText: 
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 7
  - npcText: Go ahead Lilith. Head there immediately.
    playerText: 
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 8
  - npcText: 
    playerText: '(inner thought)

      I will make them pay mom. For you. '
    isChoiceNode: 0
    option1Text: 
    option2Text: 
    nextNodeForOption1: 0
    nextNodeForOption2: 0
    nextNode: 9
  typingSpeed: 0.03
